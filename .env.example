# MONGODB_URI: MongoDB connection string used by the backend only.
# Replace the placeholders with your MongoDB Atlas or local database details.
MONGODB_URI="mongodb+srv://239x1a05l8_db_user:caEoT45F3IOOZ8aU@cluster0.cae3g9h.mongodb.net"

# PORT: Optional port for the backend API (defaults to 4000).
PORT="4000"

# JWT_SECRET: Required to sign expiring JWT login sessions stored in an HttpOnly cookie.
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
# Existing installations may keep using SESSION_SECRET until they migrate to JWT_SECRET.
SESSION_SECRET=""

# Pre-verification application uploads use private, non-static server storage.
# Set PRIVATE_UPLOAD_DIR to a persistent private volume in production.
PRIVATE_UPLOAD_DIR=""
BUSINESS_DOCUMENT_MAX_BYTES="10485760"
BUSINESS_PHOTO_MAX_BYTES="5242880"
BUSINESS_PHOTO_MIN_COUNT="2"
BUSINESS_PHOTO_MAX_COUNT="5"
BUSINESS_POST_PHOTO_MAX_BYTES="10485760"
BUSINESS_POST_VIDEO_MAX_BYTES="52428800"
BUSINESS_POST_PHOTO_MAX_COUNT="5"
BUSINESS_POST_VIDEO_MAX_COUNT="2"
BUSINESS_POST_VIDEO_MAX_DURATION_SECONDS="120"

# Optional business photo and post-media uploads. Cloudinary has a free plan;
# keep usage within its free quota. Never expose these backend secrets to Vite.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# No paid API key is needed for core place discovery: OpenStreetMap Overpass,
# Wikimedia Commons, and Wikidata are used by default. Overpass results are
# cached. Nominatim is used only for user-requested nearby searches.
# Optional Overpass interpreter overrides. The fallback defaults to the free
# community endpoint at overpass.private.coffee.
OVERPASS_URL=""
OVERPASS_FALLBACK_URL=""

# Optional external discovery cache duration in milliseconds (default: 900000).
DISCOVERY_CACHE_TTL_MS="900000"

# Optional one-time initial Admin bootstrap. Set both values before the first
# MongoDB connection when no Admin exists, then remove them from the environment.
# The bootstrap password must be at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# APP_URL: Public URL where this app is hosted. Set this in the deployment environment.
APP_URL="MY_APP_URL"
