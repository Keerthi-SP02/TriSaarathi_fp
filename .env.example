# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB connection string used by the backend only.
# Replace the placeholders with your MongoDB Atlas or local database details.
MONGODB_URI="mongodb+srv://239x1a05l8_db_user:caEoT45F3IOOZ8aU@cluster0.cae3g9h.mongodb.net"

# PORT: Optional port for the backend API (defaults to 4000).
PORT="4000"

# JWT_SECRET: Required to sign expiring JWT login sessions stored in an HttpOnly cookie.
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
# Existing installations may keep using SESSION_SECRET until they migrate to JWT_SECRET.
SESSION_SECRET=""

# Optional Cloudinary credentials for signed business photo uploads.
# These remain backend-only; never expose them through a VITE_ variable.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Overpass interpreter URL. When Overpass is unavailable or has no
# matching results, destination discovery falls back to OpenStreetMap Nominatim.
OVERPASS_URL=""

# Optional one-time initial Admin bootstrap. Set both values before the first
# MongoDB connection when no Admin exists, then remove them from the environment.
# The bootstrap password must be at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
