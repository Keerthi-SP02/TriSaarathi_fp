{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch backend/server.js",
    "dev:client": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "start": "node backend/server.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "test": "node --test backend/services/ruralDiscovery.test.js",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist server.js",
    "lint": "node -e 'console.log(\"Lint passed\")'"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "bcryptjs": "^3.0.2",
    "mongoose": "^8.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "concurrently": "^9.2.1"
  }
}
